# ── 프런트엔드 (Vite, 브라우저에 노출됨: 공개 가능한 값만) ──
# 비워 두면 local-only 모드 + 브라우저 Mock AI로 동작합니다.
VITE_SUPABASE_URL=
# Supabase "anon"(public) 키. 절대 service_role 키를 넣지 마세요.
VITE_SUPABASE_ANON_KEY=

# ── Edge Function (supabase/functions/.env 또는 `supabase secrets set`) ──
# 서버 전용. 프런트엔드 .env 에 두지 마세요.
# AI_PROVIDER=openai | mock  (미지정 시 OPENAI_API_KEY 유무로 자동 결정)
# AI_PROVIDER=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# AI_DAILY_LIMIT=100
