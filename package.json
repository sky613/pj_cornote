{
  "name": "cornote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "desktop:dev": "electron .",
    "desktop:build": "tsc -b && vite build --mode desktop",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:mac": "npm run desktop:build && electron-builder --mac --arm64 --x64",
    "desktop:win": "npm run desktop:build && electron-builder --win --x64"
  },
  "build": {
    "appId": "app.cornote.desktop",
    "productName": "Cornote",
    "icon": "public/pwa-512.png",
    "files": ["dist/**/*", "desktop/*.cjs", "package.json"],
    "directories": { "output": "desktop-release" },
    "mac": { "target": "dmg", "category": "public.app-category.education" },
    "win": { "target": "nsis" },
    "protocols": { "name": "Cornote login", "schemes": ["cornote"] }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@supabase/supabase-js": "^2.117.1",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1"
  }
}
